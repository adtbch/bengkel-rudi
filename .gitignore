# =============================================================================
# Laravel Framework — Default Ignores
# =============================================================================

# Dependencies & Vendor
/vendor
/node_modules

# Build / Compiled output
/public/build
/public/hot
/public/storage
/public/storage/*
!/public/storage/.gitkeep
/bootstrap/cache/*
!/bootstrap/cache/.gitkeep

# Environment files
.env
.env.*
.env.backup
.env.production
.env.example

# Storage — framework internals (sessions, views, cache)
/storage/framework/cache/data/*
/storage/framework/sessions/*
/storage/framework/views/*
/storage/app/private/*
/storage/app/public/*
!/storage/app/public/.gitkeep

# Logs
/storage/logs/*
!/storage/logs/.gitkeep

# =============================================================================
# Tooling & Test artifacts
# =============================================================================

/.phpunit.cache
/.phpunit.result.cache
.phpunit.result.cache
Homestead.json
Homestead.yaml
auth.json

# NPM / Yarn / PNPM
npm-debug.log
yarn-error.log
yarn-debug.log
pnpm-debug.log
npm-cache/

# PHP CS Fixer / PHPStan / IDE Helper
.php-cs-fixer.cache
/.php-cs-fixer.cache
.phpstan-cache/

# =============================================================================
# IDE & OS
# =============================================================================

# IDE
/.idea
/.vscode
*.iml

# OS
.DS_Store
Thumbs.db
*.swp
*~

# =============================================================================
# Deployment / Server
# =============================================================================

/.fleet
.forge.json
.env.forge

# Vercel (jika dipakai)
/.vercel

# =============================================================================
# Agent / Hermes internal state
# =============================================================================

/.agent
/.hermes

# Local planning documents
/PRD.md
/TIMELINE.md
/CHECKLIST.md

# Keep Laravel runtime directory placeholders
!/bootstrap/cache/.gitignore
!/storage/app/public/.gitignore
!/storage/logs/.gitignore
!/storage/framework/cache/data/.gitignore
!/storage/framework/sessions/.gitignore
!/storage/framework/views/.gitignore